# 开发环境配置
VITE_APP_TITLE=HAN Cloud
VITE_PORT=3000
VITE_PUBLIC_PATH=/
VITE_APP_BASE_API=/dev-api
VITE_DEPLOY_TIER=medium

# 开发态 /dev-api 代理的后端网关地址
VITE_DEV_PROXY_TARGET=http://10.18.35.95:9090

# 是否发送 X-User-Id 调试身份头。仅在本地绕过网关调试时打开，生产恒为关闭。
VITE_ENABLE_DEBUG_IDENTITY_HEADER=false

# 按钮级权限指令（v-hasPermi / v-hasRole）是否强制生效。
# false=宽松模式，命中失败只在控制台告警、不摘除按钮；
# 待 sql/tiers 补齐 :add/:edit 这类 F 型菜单权限点种子（S-14）后改为 true。
VITE_PERMISSION_ENFORCE=false
