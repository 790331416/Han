# =============================================
# Han Cloud 环境变量配置
# =============================================

# 数据库配置
POSTGRES_VERSION=16-alpine
POSTGRES_USER=han
POSTGRES_PASSWORD=han@2026
POSTGRES_DB=han
POSTGRES_PORT=5432

# Redis 配置
REDIS_VERSION=7-alpine
REDIS_PASSWORD=han@2026
REDIS_PORT=6379

# Nacos 配置
NACOS_VERSION=v2.3.0
NACOS_USERNAME=han
NACOS_PASSWORD=han@2026
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_PORT=8848

# 服务端口配置
GATEWAY_PORT=8080
AUTH_PORT=9200
SYSTEM_PORT=9201
TENANT_PORT=9202
WORKFLOW_PORT=9203
JOB_PORT=9204
OPEN_PORT=9205
GEN_PORT=9206
FILE_PORT=9207
MONITOR_PORT=9300

# JVM 配置
JAVA_OPTS=-Xms512m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# JobFlow 配置
JOBFLOW_SCHEDULER_THREADPOOLSIZE=20
JOBFLOW_SCHEDULER_TIMEOUT=300
JOBFLOW_SCHEDULER_LOCKTIMEOUT=60

# 时区配置
TZ=Asia/Shanghai
