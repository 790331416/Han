# =============================================
# Han Cloud 环境变量样例（根目录过渡入口专用）
# ---------------------------------------------
# 只服务于根目录的 docker-compose.yml / docker-compose-small.yml /
# docker-compose-full.yml 这三个「已弃用 / 过渡保留」的本地开发入口。
# 正式三档部署请使用 deploy/small/.env.example、deploy/medium/.env.example、
# deploy/full/.env.example，两边互不通用。
#
# 使用方式：cp .env.example .env 后逐项填写真实值。
# 下面标注「必填」的变量在 compose 里是 ${VAR:?...} 形式，缺失即启动失败，
# 不再有明文兜底默认值。
# =============================================

# ---- 必填：数据库 ----
# 生成示例：openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# ---- 必填：Redis ----
REDIS_PASSWORD=change-me

# ---- 必填：RabbitMQ（medium / full 入口使用）----
RABBITMQ_PASSWORD=change-me

# ---- 必填：RustFS 对象存储（medium / full 入口使用）----
# ACCESS_KEY 非机密，可用默认值；SECRET_KEY 必填
RUSTFS_ACCESS_KEY=hanadmin
RUSTFS_SECRET_KEY=change-me

# ---- 必填：服务间内部鉴权密钥 ----
# 所有服务与网关必须使用同一个值，泄漏等于任何人都能伪造内部调用头
# 生成示例：openssl rand -hex 32
HAN_INNER_AUTH_SECRET=change-me

# ---- 必填：Nacos 鉴权 ----
# NACOS_AUTH_ENABLE 当前在三档 compose 里仍为 false（开启需要先补齐
# NACOS_USERNAME / NACOS_PASSWORD，见 deploy/<tier>/docker-compose.yml 的
# x-nacos-env）。token 与 identity 仍必须外部注入，不得再写进仓库。
# token 需要 base64 且原始长度不少于 32 字节：openssl rand -base64 32
NACOS_AUTH_TOKEN=change-me
NACOS_AUTH_IDENTITY_VALUE=change-me

# ---- 时区 ----
TZ=Asia/Shanghai

# =============================================
# 以下为参考信息，根目录 compose 并不读取这些变量。
# 端口与镜像版本的权威口径是 deploy/<tier>/docker-compose.yml 与
# docs/03-部署手册.md，此处仅作对照，改动请以那两处为准。
# ---------------------------------------------
# 基础设施版本（三档实际使用）：
#   PostgreSQL 18.1 / Redis 8.6.0 / Nacos v3.1.1
#   RustFS 1.0.0-alpha.81 / RabbitMQ 3.13-management
#
# 容器内服务端口（宿主机端口按档位偏移，small 前缀 1、medium 前缀 2）：
#   gateway 8080 / auth 9200 / system 9201 / tenant 9202 / workflow 9203
#   job 9204 / open 9205 / file 9207 / ai 9208 / gen 9202(*) / monitor 9100
#   (*) han-gen 与 han-tenant 目前都监听 9202，属于已知端口规划冲突；
#       gen 在三档 compose 里没有宿主机端口映射所以未爆发，收敛方案待定。
# =============================================
