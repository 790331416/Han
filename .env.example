# =============================================
# Han Cloud 根 compose 环境变量样板
#
# 用法：cp .env.example .env，把所有 change-me 换成真实值，再 docker compose up。
# 服务对象是仓库根的 docker-compose.yml / docker-compose-small.yml /
# docker-compose-full.yml 三个文件。三档正式部署入口在 deploy/{small,medium,full}/，
# 各自有独立的 .env.example，不要拿这一份去填那边。
#
# 下面标「必填」的项在 compose 里是 ${VAR:?...} 形式，缺失会直接启动失败，
# 不会退回任何默认口令；标「可选」的项留空即用 compose 内的默认值。
# =============================================

# ---------- 必填：基础设施口令 ----------
# 历史上这三项都写死了同一个明文口令，并且和三档 compose、Nacos 导入 SQL 里的值完全
# 一致，等于把生产口令提交进了仓库。现在一律留 change-me，由部署人按环境填。
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me

# ---------- 必填：对象存储 ----------
RUSTFS_SECRET_KEY=change-me

# ---------- 必填：Nacos 鉴权 ----------
# 当前 compose 仍是 NACOS_AUTH_ENABLE=false，但 token 与 identity 不再写进仓库。
# token 需要 base64 且原始长度不少于 32 字节，生成示例：openssl rand -base64 32
NACOS_AUTH_TOKEN=change-me
NACOS_AUTH_IDENTITY_VALUE=change-me

# ---------- 必填：服务间内部鉴权密钥 ----------
# 必须与网关、各业务服务、Nacos 上的配置完全一致，否则 /inner/** 调用会全部 401。
# 生成示例：openssl rand -hex 32
HAN_INNER_AUTH_SECRET=change-me

# ---------- 可选：对象存储访问名 ----------
# 不填则用 compose 默认值 hanadmin
# RUSTFS_ACCESS_KEY=hanadmin

# ---------- 可选：容器内存上限 ----------
# 不填则用 compose 默认值（app 768m / nacos 1g / postgres 1g / redis 512m /
# rustfs 512m / rabbitmq 768m；small 档与 full 档默认值不同，见各自 compose）
# HAN_APP_MEM_LIMIT=768m
# HAN_NACOS_MEM_LIMIT=1g
# HAN_POSTGRES_MEM_LIMIT=1g
# HAN_REDIS_MEM_LIMIT=512m
# HAN_RUSTFS_MEM_LIMIT=512m
# HAN_RABBITMQ_MEM_LIMIT=768m

# ---------- 可选：镜像覆盖 ----------
# HAN_RABBITMQ_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/rabbitmq:3.13-management
# HAN_GEN_IMAGE=han-gen:latest

# ---------- 可选：AI 模型供应商密钥（仅 docker-compose-full.yml 使用） ----------
# 全部默认空值，只填实际启用的那几个。不要把真实 key 提交进仓库。
# HAN_AI_PROVIDER_OPENAI_API_KEY=
# HAN_AI_PROVIDER_ANTHROPIC_API_KEY=
# HAN_AI_PROVIDER_AZURE_OPENAI_API_KEY=
# HAN_AI_PROVIDER_DEEPSEEK_API_KEY=
# HAN_AI_PROVIDER_QWEN_API_KEY=
# HAN_AI_PROVIDER_ZHIPU_API_KEY=
# HAN_AI_PROVIDER_SILICONFLOW_API_KEY=
# HAN_AI_PROVIDER_OLLAMA_API_KEY=

# =============================================
# 以下变量曾经写在本文件里，但根 compose 从来不读它们，填了也不会生效，
# 因此本次移除。需要改这些值请直接改对应的 compose 文件：
#   POSTGRES_VERSION / REDIS_VERSION / NACOS_VERSION
#       —— 镜像 tag 在 compose 的 image: 上写死（当前 postgres:18.1、redis:8.6.0、
#          nacos:v3.1.1，与本文件原先写的 16-alpine / 7-alpine / v2.3.0 早已对不上）
#   POSTGRES_USER / POSTGRES_DB / NACOS_USERNAME / NACOS_PASSWORD
#   POSTGRES_PORT / REDIS_PORT / NACOS_PORT / GATEWAY_PORT / AUTH_PORT /
#   SYSTEM_PORT / TENANT_PORT / WORKFLOW_PORT / JOB_PORT / OPEN_PORT /
#   GEN_PORT / FILE_PORT / MONITOR_PORT
#   JAVA_OPTS / TZ
#   JOBFLOW_SCHEDULER_THREADPOOLSIZE / JOBFLOW_SCHEDULER_TIMEOUT /
#   JOBFLOW_SCHEDULER_LOCKTIMEOUT
# =============================================
