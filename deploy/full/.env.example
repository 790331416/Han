HAN_DEPLOY_TIER=full
HAN_SQL_ROOT=/opt/han/repo/Han/sql
HAN_INNER_AUTH_SECRET=han-cloud-inner-auth
TZ=Asia/Shanghai
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
RUSTFS_ACCESS_KEY=hanadmin
RUSTFS_SECRET_KEY=change-me
DEEPSEEK_API_KEY=
HAN_AI_PROVIDER_DEEPSEEK_API_KEY=
VOLCENGINE_ARK_API_KEY=
HAN_AIVIDEO_MEDIA_PUBLIC_FILE_ORIGIN=http://127.0.0.1:3000
# SSRF 防护（G1-12）：生产默认拒绝内网/环回地址（留空即默认安全）；
# e2e 回归环境需设 AI_SSRF_ALLOWED_HOSTS=127.0.0.1 以放行用例占位地址
AI_SSRF_ALLOWED_HOSTS=
HAN_FILE_MAX_FILE_SIZE=300MB
HAN_FILE_MAX_REQUEST_SIZE=320MB
HAN_GATEWAY_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-gateway:latest
HAN_AUTH_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-auth:latest
HAN_SYSTEM_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-system:latest
HAN_TENANT_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-tenant:latest
HAN_WORKFLOW_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-workflow:latest
HAN_JOB_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-job:latest
HAN_OPEN_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-open:latest
HAN_FILE_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-file:latest
HAN_AI_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-ai:latest
HAN_AIVIDEO_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-aivideo:latest
HAN_GEN_IMAGE=han-gen:latest
HAN_UI_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-ui:latest
