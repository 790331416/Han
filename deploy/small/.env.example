HAN_DEPLOY_TIER=small
# 仓库 sql 目录在本机上的绝对路径。Docker 对不存在的 bind mount 源会静默创建
# 空目录，Postgres 就会初始化成一个没有任何业务表的空库（S-89 就是这么来的），
# 所以这里填错不会报错、只会得到一个空库。
# 95 用下面这个路径；本地开发请改成自己的仓库路径，或删掉本行走默认的 ../../sql。
HAN_SQL_ROOT=/opt/han/repo/Han/sql
TZ=Asia/Shanghai
# 以下敏感项在 compose 里是 ${VAR:?...} 形式，缺失即启动失败，务必逐项填写真实值。
# HAN_INNER_AUTH_SECRET 必须三档一致且与网关一致，生成示例：openssl rand -hex 32
HAN_INNER_AUTH_SECRET=change-me
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Nacos 鉴权当前仍为 NACOS_AUTH_ENABLE=false，但 token 与 identity 不再写进仓库。
# token 需要 base64 且原始长度不少于 32 字节，生成示例：openssl rand -base64 32
NACOS_AUTH_TOKEN=change-me
NACOS_AUTH_IDENTITY_VALUE=change-me
HAN_GATEWAY_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-gateway:latest
HAN_AUTH_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-auth:latest
HAN_SYSTEM_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-system:latest
HAN_JOB_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-job:latest
HAN_UI_IMAGE=registry.cn-hangzhou.aliyuncs.com/xzy0112/han-ui:latest
