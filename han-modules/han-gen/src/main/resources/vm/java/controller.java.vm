package ${packageName}.controller.admin;

import com.han.common.core.domain.PageResult;
import com.han.common.core.domain.R;
#if($hasDtoColumn || $hasPk)
import com.han.common.log.annotation.OperLog;
#end
import com.han.common.security.annotation.AdminAuth;
#if($hasDtoColumn || $hasPk)
import com.han.common.security.annotation.RepeatSubmit;
#end
#if($hasDtoColumn)
import ${packageName}.domain.dto.${className}Dto;
#end
import ${packageName}.domain.po.${className}Po;
import ${packageName}.domain.query.${className}Query;
import ${packageName}.service.I${className}Service;
#if($hasDtoColumn)
import jakarta.validation.Valid;
#end
import lombok.RequiredArgsConstructor;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.*;

/**
 * ${tableComment} - 管理端控制器
 *
 * @author ${author}
 * @date ${date}
 */
@AdminAuth
@RestController("admin${className}Controller")
@RequestMapping("/${moduleName}/${businessName}")
@RequiredArgsConstructor
public class A${className}Controller {

    private final I${className}Service ${classname}Service;

    @GetMapping("/list")
    @PreAuthorize("@ss.hasAuthority('${moduleName}:${businessName}:list')")
    public R<PageResult<${className}Po>> list(${className}Query query) {
        return R.ok(${classname}Service.select${className}Page(query));
    }
#if($hasPk)

    @GetMapping("/{${pkJavaField}}")
    @PreAuthorize("@ss.hasAuthority('${moduleName}:${businessName}:query')")
    public R<${className}Po> getInfo(@PathVariable ${pkJavaType} ${pkJavaField}) {
        return R.ok(${classname}Service.getById(${pkJavaField}));
    }
#end
#if($hasDtoColumn)

    @RepeatSubmit
    @PostMapping
    @PreAuthorize("@ss.hasAuthority('${moduleName}:${businessName}:add')")
    @OperLog(module = "${tableComment}", type = OperLog.OperType.INSERT)
    public R<Void> add(@Valid @RequestBody ${className}Dto dto) {
        ${classname}Service.insert${className}(dto);
        return R.ok();
    }
#if($hasPk)

    @RepeatSubmit
    @PostMapping("/edit")
    @PreAuthorize("@ss.hasAuthority('${moduleName}:${businessName}:edit')")
    @OperLog(module = "${tableComment}", type = OperLog.OperType.UPDATE)
    public R<Void> edit(@Valid @RequestBody ${className}Dto dto) {
        ${classname}Service.update${className}(dto);
        return R.ok();
    }
#end
#end
#if($hasPk)

    @RepeatSubmit
    @PostMapping("/remove/{${pkJavaField}}")
    @PreAuthorize("@ss.hasAuthority('${moduleName}:${businessName}:remove')")
    @OperLog(module = "${tableComment}", type = OperLog.OperType.DELETE)
    public R<Void> remove(@PathVariable ${pkJavaType} ${pkJavaField}) {
        ${classname}Service.removeById(${pkJavaField});
        return R.ok();
    }
#else

    // 表 ${tableName} 没有单列主键（无主键或复合主键），
    // 按主键查询 / 修改 / 删除的端点无法自动生成，请按业务语义自行补充。
#end
}
