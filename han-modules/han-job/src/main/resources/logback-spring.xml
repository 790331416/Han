<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- JobFlow 特性：TraceId 全链路追踪 -->
    
    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}] [%X{jobId}] [%X{shardIndex}] %-5level %logger{50} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件输出 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/han-job.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}] [%X{jobId}] [%X{shardIndex}] %-5level %logger{50} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/han-job.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- JSON 格式输出（用于 ELK） -->
    <appender name="JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/han-job-json.log</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"han-job"}</customFields>
            <!-- TraceId 会自动从 MDC 中提取 -->
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/han-job-json.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 根日志级别 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <!-- 如果需要接入 ELK，启用 JSON appender -->
        <!-- <appender-ref ref="JSON"/> -->
    </root>

    <!-- JobFlow 相关日志级别 -->
    <logger name="com.han.job" level="INFO"/>
    <logger name="com.han.job.shard" level="DEBUG"/>  <!-- 分片日志详细输出 -->
    <logger name="com.han.job.lock" level="DEBUG"/>   <!-- 分布式锁日志 -->

</configuration>
